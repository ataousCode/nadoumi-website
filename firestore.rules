rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow admins (authenticated users) to read/write applications documents
    match /applications/{applicationId} {
      // Public can create application documents (submission)
      allow create: if true;
      // Authenticated users (admins) can read/update/delete
      allow read, update, delete: if request.auth != null;
    }

    // Allow admins to manage categories
    match /categories/{categoryId} {
      allow read: if true; // Public needs to read categories for the menu/forms
      allow write: if request.auth != null;
    }

    // Allow admins to manage products
    match /products/{productId} {
      allow read: if true; // Public needs to read products
      allow write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}