rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // Allow admins (authenticated users) to read/write application documents
    match /applications/{applicationId}/{allPaths=**} {
      // Admins (authenticated users) can read and list application documents
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      // Allow public uploads for application submissions
      allow write: if true;
    }

    // Allow admins to read and list all other storage paths to support legacy uploads
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      allow write: if false;
    }
  }
}
