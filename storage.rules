rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Application documents - allow public uploads and authenticated reads
    match /applications/{applicationId}/{allPaths=**} {
      // Anyone can upload (for application form submissions)
      allow create, write: if true;
      // Authenticated users (admins) can read and list
      allow read, list: if request.auth != null;
      // Allow public read for the submitter temporarily (optional)
      allow get: if true;
    }

    // Categories icons - public read, admin write
    match /categories/{allPaths=**} {
      allow read, list: if true;
      allow write, create: if request.auth != null;
    }

    // Products images - public read, admin write
    match /products/{allPaths=**} {
      allow read, list: if true;
      allow write, create: if request.auth != null;
    }

    // All other paths - admin only
    match /{allPaths=**} {
      allow read, list: if request.auth != null;
      allow write, create: if request.auth != null;
    }
  }
}
